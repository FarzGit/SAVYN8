# Canonical site URL (used for sitemap, canonical links, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.sevyn8.com

# Waitlist form endpoint. Any service that accepts a JSON POST works
# (Formspree, Basin, Getform, a Vercel/Netlify function, your own API).
# Body sent: { "email": "...", "source": "home-hero", "website": "" }  ("website" is a honeypot)
# Leave empty to fall back to a pre-filled email to CONTACT_EMAIL.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Optional cookieless analytics (Plausible). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
